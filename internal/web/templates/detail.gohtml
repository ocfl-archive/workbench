{{if .Job}}
<div class="flex flex-col h-full gap-4">
    <!-- Header with Signature & Status -->
    <div class="flex flex-wrap items-start justify-between gap-3 pb-3 border-b border-base-200">
        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
                <span class="badge badge-sm badge-ghost font-mono text-[10px]">Job</span>
                <h3 class="text-base font-bold font-mono tracking-tight text-primary truncate" title="{{.Job.Signature}}">
                    {{.Job.Signature}}
                </h3>
            </div>
            {{if .Job.Title}}
            <h4 class="text-xs font-medium text-base-content/80 mt-1 leading-snug break-words">
                {{.Job.Title}}
            </h4>
            {{end}}
        </div>
        <div class="flex items-center gap-2 shrink-0">
            {{if eq .Job.Status "error"}}
            <span class="badge badge-sm badge-error gap-1 font-semibold">
                <span class="app-icon icon-alert-circle w-3 h-3"></span>
                Fehler
            </span>
            {{else if eq .Job.Status "archived"}}
            <span class="badge badge-sm badge-success gap-1 font-semibold">
                <span class="app-icon icon-check-circle w-3 h-3"></span>
                Archiviert
            </span>
            {{else}}
            <span class="badge badge-sm badge-info badge-soft font-mono">
                Incoming
            </span>
            {{end}}

            {{if .Job.IngestID}}
            <span class="badge badge-sm badge-outline font-mono text-[10px]" title="ONA Ingest ID">
                ID: {{.Job.IngestID}}
            </span>
            {{end}}
        </div>
    </div>

    <!-- Metadata & File Paths Overview -->
    <div class="flex-1 overflow-y-auto space-y-2 pr-1 max-h-[460px]">
        <div class="text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-1">
            Pfade &amp; Artefakte
        </div>

        <div class="grid grid-cols-1 gap-2 text-xs">
            {{if .Job.IncomingFolder}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Incoming Folder</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.IncomingFolder}}</span>
            </div>
            {{end}}

            {{if .Job.InfoFile}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Info File (JSON)</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.InfoFile}}</span>
            </div>
            {{end}}

            {{if .Job.DataFolder}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Data Folder</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.DataFolder}}</span>
            </div>
            {{end}}

            {{if .Job.MetadataFolder}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Metadata Folder</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.MetadataFolder}}</span>
            </div>
            {{end}}

            {{if .Job.OcflFile}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">OCFL Container (.zip)</span>
                <span class="font-mono text-xs break-all select-all text-success font-semibold">{{.Job.OcflFile}}</span>
            </div>
            {{end}}

            {{if .Job.ChecksumFile}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Checksum File (.sha512)</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.ChecksumFile}}</span>
            </div>
            {{end}}

            {{if .Job.ReportFile}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Report File (.pdf)</span>
                <span class="font-mono text-xs break-all select-all text-success font-semibold">{{.Job.ReportFile}}</span>
            </div>
            {{end}}

            {{if .Job.UploadFile}}
            <div class="p-2.5 rounded-xl bg-base-200/50 border border-base-200 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-base-content/60 uppercase">Upload Record (.upload.json)</span>
                <span class="font-mono text-xs break-all select-all">{{.Job.UploadFile}}</span>
            </div>
            {{end}}

            {{if .Job.ErrorFile}}
            <div class="p-2.5 rounded-xl bg-error/10 border border-error/20 flex flex-col gap-0.5">
                <span class="text-[10px] font-bold text-error uppercase">Error Log File</span>
                <span class="font-mono text-xs break-all select-all text-error">{{.Job.ErrorFile}}</span>
            </div>
            {{end}}
        </div>
    </div>

    <!-- Action Buttons Toolbar -->
    <div class="pt-3 border-t border-base-200 mt-auto">
        <div class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider mb-2">
            Verfügbare Aktionen
        </div>

        <div class="flex flex-wrap gap-2">
            {{range .Job.AvailableActions}}
                {{if eq . "reset"}}
                <button
                    type="button"
                    class="btn btn-sm btn-warning gap-1.5 shadow-sm font-semibold flex-1 min-w-[140px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/reset"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-trash w-3.5 h-3.5"></span>
                    <span>{{actionLabel "reset"}}</span>
                </button>
                {{else if eq . "check_status"}}
                <button
                    type="button"
                    class="btn btn-sm btn-info gap-1.5 shadow-sm font-semibold flex-1 min-w-[140px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/check_status"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-clock w-3.5 h-3.5"></span>
                    <span>{{actionLabel "check_status"}}</span>
                </button>
                {{else if eq . "create_ocfl"}}
                <button
                    type="button"
                    class="btn btn-sm btn-primary gap-1.5 shadow-sm font-semibold flex-1 min-w-[130px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/create_ocfl"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-chip w-3.5 h-3.5"></span>
                    <span>{{actionLabel "create_ocfl"}}</span>
                </button>
                {{else if eq . "validate"}}
                <button
                    type="button"
                    class="btn btn-sm btn-secondary gap-1.5 shadow-sm font-semibold flex-1 min-w-[110px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/validate"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-check w-3.5 h-3.5"></span>
                    <span>{{actionLabel "validate"}}</span>
                </button>
                {{else if eq . "create_report"}}
                <button
                    type="button"
                    class="btn btn-sm btn-accent gap-1.5 shadow-sm font-semibold flex-1 min-w-[130px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/create_report"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-book w-3.5 h-3.5"></span>
                    <span>{{actionLabel "create_report"}}</span>
                </button>
                {{else if eq . "ingest"}}
                <button
                    type="button"
                    class="btn btn-sm btn-success text-success-content gap-1.5 shadow-sm font-semibold flex-1 min-w-[110px]"
                    hx-post="/batch/{{$.Job.Batch}}/job/{{$.Job.BaseName}}/action/ingest"
                    hx-target="#action-alert"
                    hx-swap="innerHTML">
                    <span class="app-icon icon-arrow-right w-3.5 h-3.5"></span>
                    <span>{{actionLabel "ingest"}}</span>
                </button>
                {{end}}
            {{else}}
            <div class="text-xs text-base-content/50 italic py-1">
                Keine Aktionen für diesen Zustand verfügbar
            </div>
            {{end}}
        </div>
    </div>
</div>
{{else}}
<div class="flex flex-col items-center justify-center h-full py-16 text-center text-base-content/50 gap-2">
    <span class="app-icon icon-info-circle w-8 h-8 opacity-40"></span>
    <span class="text-xs">Wählen Sie einen Job aus der Liste aus</span>
</div>
{{end}}
